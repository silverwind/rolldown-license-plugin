    "rolldown": "1.2.6",
    "tsdown": "0.22.14",
    "tsdown-config-silverwind": "4.0.3",
    "typescript": "6.0.3",
    "typescript-config-silverwind": "20.0.3",
    "updates": "18.0.7",
    "updates-config-silverwind": "4.0.5",
    "versions": "15.3.7",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "vitest-config-silverwind": "11.6.1"
  },
  "packageManager": "pnpm@11.24.0"
