{
  "name": "rolldown-license-plugin",
  "version": "3.0.13",
  "description": "Rolldown/Vite plugin to extract dependency licenses and optionally validate them. Zero dependencies, optimized for performance.",
  "author": "silverwind <me@silverwind.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silverwind/rolldown-license-plugin.git"
  },
  "license": "BSD-2-Clause",
  "keywords": [
    "rolldown",
    "rolldown-plugin",
    "vite",
    "vite-plugin",
    "license",
    "licenses",
    "third-party"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": "*",
    "bun": "*"
  },
  "peerDependencies": {
    "rolldown": "*"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "eslint": "10.11.0",
    "eslint-config-silverwind": "151.0.0",
    "rolldown": "1.2.11",
    "tsdown": "0.23.0",
    "tsdown-config-silverwind": "4.1.1",
    "typescript": "6.0.3",
    "typescript-config-silverwind": "21.0.0",
    "updates": "19.0.0",
    "updates-config-silverwind": "4.0.6",
    "versions": "15.5.0",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "vitest-config-silverwind": "12.0.4"
  },
  "packageManager": "pnpm@12.6.0"
}
